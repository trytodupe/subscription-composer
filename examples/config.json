{
  "listen": "127.0.0.1:8080",
  "snapshot_dir": "../state",
  "refresh_timeout": "20s",
  "debounce": "2s",
  "check_binary": "sing-box",
  "sources": [
    {
      "id": "demo",
      "file": "nodes.json",
      "format": "sing-box"
    }
  ],
  "policy": {
    "country_overrides": {
      "demo/JP Demo": "JP",
      "demo/US Demo": "US"
    },
    "direct_domains": [
      "campus.example.edu"
    ],
    "direct_cidrs": [],
    "regional_domains": [
      "google.com",
      "googleapis.com",
      "gstatic.com",
      "googleusercontent.com"
    ],
    "rules": [
      {
        "rule_set": [
          "geosite-google"
        ],
        "action": "route",
        "outbound": "regional"
      }
    ],
    "rule_sets": [
      {
        "type": "remote",
        "tag": "geosite-google",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/2dust/sing-box-rules/rule-set-geosite/geosite-google.srs",
        "update_interval": "24h",
        "download_detour": "direct"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/2dust/sing-box-rules/rule-set-geosite/geosite-cn.srs",
        "update_interval": "24h",
        "download_detour": "direct"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/2dust/sing-box-rules/rule-set-geoip/geoip-cn.srs",
        "update_interval": "24h",
        "download_detour": "direct"
      }
    ],
    "direct_rule_sets": [
      "geosite-cn",
      "geoip-cn"
    ],
    "test_url": "https://www.gstatic.com/generate_204",
    "test_interval": "5m"
  },
  "devices": [
    {
      "id": "macos",
      "platform": "macos",
      "token": "env:SUBCOMPOSE_MACOS_TOKEN",
      "base": {
        "log": {
          "level": "info",
          "timestamp": true
        },
        "inbounds": [
          {
            "type": "tun",
            "tag": "tun-in",
            "address": [
              "172.19.0.1/30"
            ],
            "auto_route": true,
            "mtu": 1500,
            "stack": "mixed"
          }
        ],
        "outbounds": [
          {
            "type": "direct",
            "tag": "direct"
          }
        ],
        "endpoints": [
          {
            "type": "tailscale",
            "tag": "tailscale",
            "state_directory": "tailscale",
            "accept_routes": true
          }
        ],
        "dns": {
          "servers": [
            {
              "type": "udp",
              "tag": "bootstrap",
              "server": "223.5.5.5"
            },
            {
              "type": "local",
              "tag": "campus-dns"
            },
            {
              "type": "https",
              "tag": "direct-dns",
              "server": "dns.alidns.com",
              "domain_resolver": "bootstrap"
            },
            {
              "type": "https",
              "tag": "proxy-dns",
              "server": "cloudflare-dns.com",
              "domain_resolver": "bootstrap",
              "detour": "main"
            },
            {
              "type": "tailscale",
              "tag": "tailnet-dns",
              "endpoint": "tailscale"
            }
          ],
          "rules": [
            {
              "preferred_by": "tailnet-dns",
              "action": "route",
              "server": "tailnet-dns"
            },
            {
              "domain_suffix": [
                "campus.example.edu"
              ],
              "action": "route",
              "server": "campus-dns"
            },
            {
              "rule_set": [
                "geosite-cn"
              ],
              "action": "route",
              "server": "direct-dns"
            }
          ],
          "final": "proxy-dns"
        },
        "route": {
          "auto_detect_interface": true,
          "default_domain_resolver": "bootstrap",
          "rules": [
            {
              "action": "sniff"
            },
            {
              "protocol": "dns",
              "action": "hijack-dns"
            },
            {
              "preferred_by": [
                "tailscale"
              ],
              "action": "route",
              "outbound": "tailscale"
            },
            {
              "ip_is_private": true,
              "action": "route",
              "outbound": "direct"
            }
          ]
        },
        "experimental": {
          "cache_file": {
            "enabled": true
          }
        }
      }
    },
    {
      "id": "android",
      "platform": "android",
      "token": "env:SUBCOMPOSE_ANDROID_TOKEN",
      "base": {
        "log": {
          "level": "info",
          "timestamp": true
        },
        "inbounds": [
          {
            "type": "tun",
            "tag": "tun-in",
            "address": [
              "172.19.0.1/30"
            ],
            "auto_route": true,
            "mtu": 1500,
            "stack": "mixed"
          }
        ],
        "outbounds": [
          {
            "type": "direct",
            "tag": "direct"
          }
        ],
        "endpoints": [
          {
            "type": "tailscale",
            "tag": "tailscale",
            "state_directory": "tailscale",
            "accept_routes": true
          }
        ],
        "dns": {
          "servers": [
            {
              "type": "udp",
              "tag": "bootstrap",
              "server": "223.5.5.5"
            },
            {
              "type": "local",
              "tag": "campus-dns"
            },
            {
              "type": "https",
              "tag": "direct-dns",
              "server": "dns.alidns.com",
              "domain_resolver": "bootstrap"
            },
            {
              "type": "https",
              "tag": "proxy-dns",
              "server": "cloudflare-dns.com",
              "domain_resolver": "bootstrap",
              "detour": "main"
            },
            {
              "type": "tailscale",
              "tag": "tailnet-dns",
              "endpoint": "tailscale"
            }
          ],
          "rules": [
            {
              "preferred_by": "tailnet-dns",
              "action": "route",
              "server": "tailnet-dns"
            },
            {
              "domain_suffix": [
                "campus.example.edu"
              ],
              "action": "route",
              "server": "campus-dns"
            },
            {
              "rule_set": [
                "geosite-cn"
              ],
              "action": "route",
              "server": "direct-dns"
            }
          ],
          "final": "proxy-dns"
        },
        "route": {
          "auto_detect_interface": true,
          "default_domain_resolver": "bootstrap",
          "rules": [
            {
              "action": "sniff"
            },
            {
              "protocol": "dns",
              "action": "hijack-dns"
            },
            {
              "preferred_by": [
                "tailscale"
              ],
              "action": "route",
              "outbound": "tailscale"
            },
            {
              "ip_is_private": true,
              "action": "route",
              "outbound": "direct"
            }
          ]
        },
        "experimental": {
          "cache_file": {
            "enabled": true
          }
        }
      }
    }
  ]
}
